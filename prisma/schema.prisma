// RevMeet — Prisma schema
// PostgreSQL (works on Vercel/Neon and any Postgres). Point DATABASE_URL at
// your database. Locally you can use a free Neon database or local Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app at runtime (serverless-friendly).
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection used for schema changes / `db push`.
  // Neon's Vercel integration provides DATABASE_URL_UNPOOLED automatically.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Enum-like values are stored as String and constrained in the application
// layer (see src/lib/enums.ts + Zod):
//   Role:        ENTHUSIAST | ORGANISER | VENUE | ADMIN
//   EventType:   CAR_SHOW | TRACK_DAY | NIGHT_CRUISE | DRIFT_EVENT | STANCE_MEET
//                | JDM_MEET | CLASSIC_CARS | SUPERCAR_MEET | MEET
//   EventStatus: DRAFT | PUBLISHED | CANCELLED

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String? // null for accounts that only sign in via Google
  googleId     String?  @unique
  name         String
  role         String   @default("ENTHUSIAST")
  suspended    Boolean  @default(false) // moderation: blocks login & hides content
  bio          String?
  avatarColor  String   @default("#FF5F1F")
  avatarUrl    String?
  // "Garage" — the member's car/build shown on their public profile.
  carMake      String?
  carModel     String?
  carYear      Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  club          Club?
  venue         Venue?
  events        Event[]        @relation("EventOrganiser")
  registrations Registration[]
  clubFollows   ClubFollow[]
  venueFollows  VenueFollow[]
  reviews       Review[]
  savedEvents   SavedEvent[]
  promotions    Promotion[]
  reportsMade   Report[]       @relation("ReportsMade")
  photos        Photo[]
  notifications Notification[]
}

// User-uploaded photos: a member's build gallery (eventId null) or photos
// attached to an event they attended (eventId set).
model Photo {
  id         String   @id @default(cuid())
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  eventId    String?
  event      Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url        String
  caption    String?
  createdAt  DateTime @default(now())

  @@index([uploaderId])
  @@index([eventId])
}

// In-app notification (bell menu).
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// User-submitted moderation reports (flagging events or reviews).
model Report {
  id         String    @id @default(cuid())
  reporterId String?
  reporter   User?     @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: SetNull)
  targetType String // EVENT | REVIEW
  targetId   String
  reason     String
  detail     String?
  status     String    @default("OPEN") // OPEN | RESOLVED | DISMISSED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status])
}

// Organiser / car club profile (one per organiser account)
model Club {
  id          String   @id @default(cuid())
  ownerId     String   @unique
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  slug        String   @unique
  description String
  location    String
  region      String?
  imageUrl    String?
  website     String?
  categories  String   @default("") // comma-separated tags
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events  Event[]
  follows ClubFollow[]
  reviews Review[]
}

// Venue profile — a place that promotes itself as a location for meets/events
model Venue {
  id          String   @id @default(cuid())
  ownerId     String   @unique
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  slug        String   @unique
  description String
  address     String
  city        String
  postcode    String?
  lat         Float
  lng         Float
  imageUrl    String?
  website     String?
  capacity    Int?
  amenities   String   @default("") // comma-separated
  categories  String   @default("") // comma-separated
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events  Event[]
  follows VenueFollow[]
  reviews Review[]
}

model Event {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  description String
  type        String
  status      String   @default("PUBLISHED")
  startsAt    DateTime
  endsAt      DateTime?
  city        String
  region      String?
  address     String?
  lat         Float
  lng         Float
  imageUrl    String?
  capacity    Int?
  priceInfo   String? // e.g. "Free" or "£15 on the gate"
  // Comma-separated amenity keys (see src/lib/amenities.ts). Defaults from the
  // selected venue at creation; editable per event.
  amenities   String  @default("")
  // Promoted placement (paid) — featured events sort first and get a badge.
  featured      Boolean   @default(false)
  featuredUntil DateTime? // when the paid promotion expires
  // Groups occurrences of a recurring event (shared cuid); null for one-offs.
  seriesId    String?

  organiserId String
  organiser   User    @relation("EventOrganiser", fields: [organiserId], references: [id], onDelete: Cascade)

  clubId String?
  club   Club?   @relation(fields: [clubId], references: [id], onDelete: SetNull)

  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations Registration[]
  reviews       Review[]
  savedBy       SavedEvent[]
  promotions    Promotion[]
  photos        Photo[]

  @@index([type])
  @@index([startsAt])
  @@index([seriesId])
}

// A paid featured-placement purchase (Stripe). One row per completed checkout,
// keyed by the Stripe session for idempotency across the success redirect and
// the webhook.
model Promotion {
  id              String   @id @default(cuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Int // pence
  currency        String   @default("gbp")
  days            Int
  stripeSessionId String   @unique
  createdAt       DateTime @default(now())
  expiresAt       DateTime
}

model Registration {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  // Set once the pre-event reminder email has gone out (cron), so it never sends twice.
  reminderSent Boolean  @default(false)

  @@unique([userId, eventId])
}

model ClubFollow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, clubId])
}

model VenueFollow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, venueId])
}

model SavedEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
}

// A review targets exactly one of an event, club or venue.
model Review {
  id        String   @id @default(cuid())
  rating    Int // 1-5
  body      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  clubId    String?
  club      Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  venueId   String?
  venue     Venue?   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // NULLs are distinct in Postgres, so each unique only binds when its column
  // is set — one review per user per event / club / venue.
  @@unique([userId, eventId])
  @@unique([userId, clubId])
  @@unique([userId, venueId])
}
