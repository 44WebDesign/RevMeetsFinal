# RevMeet environment

# PostgreSQL connection string (Vercel/Neon or any Postgres).
# Neon (free): https://neon.tech — create a project and copy the connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Public site URL — used for canonical links, the sitemap and structured data.
# On Vercel this is detected automatically; set it only when using a custom
# domain, e.g. https://revmeet.co.uk
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Homepage header style. "classic" (default) = photo hero; "map" = a full-screen
# interactive map with the search overlaid. Preview either live without changing
# this by visiting /?home=map or /?home=classic.
# HOME_LAYOUT="classic"

# Google Maps (optional). With a key, every map on the site renders as real
# Google Maps (light "Voyager"-style look). Without it, maps fall back to the
# free CARTO Voyager basemap (same light look, no key or cost). To get a key:
# https://console.cloud.google.com → enable the "Maps JavaScript API", create an
# API key under Credentials, and enable billing (Google gives a generous free
# monthly tier). Restrict the key to your domain(s). It is a PUBLIC key (sent to
# the browser) — restriction is what protects it. Must be prefixed
# NEXT_PUBLIC_ so it is available client-side; it is baked in at build time, so
# redeploy after setting it.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Session signing secret. Generate one: `openssl rand -base64 32`
JWT_SECRET="change-me"

# Google sign-in (optional). Leave blank to hide the "Continue with Google"
# button. Create an OAuth client at https://console.cloud.google.com →
# APIs & Services → Credentials → OAuth client ID (type: Web application),
# add redirect URI  <your-url>/api/auth/google/callback  (and the localhost one
# http://localhost:3000/api/auth/google/callback), then paste the values here.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# One-time demo-data seeding via /api/dev/seed?token=... Set this to any random
# string to enable it, visit the URL once, then remove it. Only runs on an
# empty database (it refuses if any user already exists).
SEED_TOKEN=""

# One-time admin bootstrap. Set to any random string, then — while logged in
# with the account you want to make an admin — visit
#   /api/admin/claim?token=THIS_VALUE
# to promote that account. Remove it again afterwards.
ADMIN_CLAIM_TOKEN=""

# Email notifications (optional) — registration confirmations, new-event alerts
# to club followers, and pre-event reminders. Create a free API key at
# https://resend.com. Without it, emails are skipped (logged to console).
RESEND_API_KEY=""
# Sender address. The resend.dev default works out of the box for testing;
# verify your own domain in Resend to send as e.g. "RevMeet <hello@yourdomain>".
EMAIL_FROM=""
# Where contact-form messages are emailed. If blank, they go to all admins
# (and are always stored in the database either way).
SUPPORT_EMAIL=""

# Protects the scheduled cron jobs — the daily reminder (/api/cron/reminders)
# and the weekly "events near you" digest (/api/cron/digest). On Vercel, set any
# random string — Vercel automatically sends it as a Bearer token with cron
# invocations. Optional: without it the routes are publicly callable (harmless,
# they only send pending reminders / digests). Both emails require RESEND_API_KEY.
CRON_SECRET=""

# Image uploads use Vercel Blob. In Vercel: Storage → Create → Blob, which sets
# BLOB_READ_WRITE_TOKEN automatically. Without it, users paste image URLs.
# BLOB_READ_WRITE_TOKEN=""

# Paid "Featured event" promotion via Stripe (optional). Add your Stripe secret
# key to enable the "Feature for £… / N days" button on the event manage page.
# Get keys at https://dashboard.stripe.com/apikeys (use a test key sk_test_… to
# trial it). Without it, promotion is shown as "not enabled".
STRIPE_SECRET_KEY=""
# Optional overrides (defaults: £9.99 for 30 days).
# FEATURED_PRICE_GBP="9.99"
# FEATURED_DAYS="30"
# Optional but recommended: a webhook signing secret so promotions still apply
# even if the buyer closes the tab before returning. In Stripe → Developers →
# Webhooks, add an endpoint for <your-url>/api/stripe/webhook listening for
# "checkout.session.completed", then paste its signing secret (whsec_…) here.
STRIPE_WEBHOOK_SECRET=""

# Error monitoring via Sentry (optional). Entirely opt-in: with no DSN set, the
# Sentry SDK and its build plugin stay completely dormant (the build is
# identical to a Sentry-free project). To enable: create a free project at
# https://sentry.io, copy its DSN, and set the PUBLIC one below (client + server
# both use it). Must be prefixed NEXT_PUBLIC_ to reach the browser.
# NEXT_PUBLIC_SENTRY_DSN=""
# Optional: upload source maps for readable stack traces. Needs all three — an
# auth token (Sentry → Settings → Auth Tokens), your org and project slugs.
# Without the token, errors are still reported, just with minified traces.
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# Vercel Analytics (page views / visitors) needs NO env var — it's enabled by
# the <Analytics /> component and activates automatically on Vercel. Turn it on
# in the Vercel dashboard under your project's Analytics tab.
