# RevMeet environment

# PostgreSQL connection string (Vercel/Neon or any Postgres).
# Neon (free): https://neon.tech — create a project and copy the connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Public site URL — used for canonical links, the sitemap and structured data.
# On Vercel this is detected automatically; set it only when using a custom
# domain, e.g. https://revmeet.co.uk
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Session signing secret. Generate one: `openssl rand -base64 32`
JWT_SECRET="change-me"

# Google sign-in (optional). Leave blank to hide the "Continue with Google"
# button. Create an OAuth client at https://console.cloud.google.com →
# APIs & Services → Credentials → OAuth client ID (type: Web application),
# add redirect URI  <your-url>/api/auth/google/callback  (and the localhost one
# http://localhost:3000/api/auth/google/callback), then paste the values here.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# One-time demo-data seeding via /api/dev/seed?token=... Set this to any random
# string to enable it, visit the URL once, then remove it. Only runs on an
# empty database (it refuses if any user already exists).
SEED_TOKEN=""
