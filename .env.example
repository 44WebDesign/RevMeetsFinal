# RevMeet environment
# Generate a real secret for production: `openssl rand -base64 32`

DATABASE_URL="file:./dev.db"
JWT_SECRET="dev-only-secret-change-me-in-production-0000000000"

# Google sign-in (optional). Leave blank to hide the "Continue with Google"
# button. To enable: create an OAuth client at https://console.cloud.google.com
# → APIs & Services → Credentials → OAuth client ID (type: Web application),
# add the redirect URI  http://localhost:3000/api/auth/google/callback
# (and your production URL), then paste the values below.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
